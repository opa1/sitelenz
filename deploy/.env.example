# =============================================================================
# SiteLenz production environment — /opt/apps/sitelenz/.env on the OCI VM.
#
# Copy to .env on the server and fill in every REPLACE_* value. This file is
# never synced by CI (see .github/workflows/deploy-production.yml) — it's
# server state, not repo state.
#
# Every variable below is read by src/config/configuration.ts /
# src/config/env.validation.ts — this list is exhaustive as of that module,
# not a guess.
# =============================================================================

NODE_ENV=production
PORT=3002

# -----------------------------------------------------------------------------
# NETWORK — selects which of the network-specific blocks below is active.
# One of: testnet | mainnet
# -----------------------------------------------------------------------------
NETWORK=testnet

# --- Algorand / x402 — testnet -----------------------------------------------
TESTNET_ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
TESTNET_X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
TESTNET_PAY_TO_ADDRESS=REPLACE_WITH_TESTNET_ALGORAND_ADDRESS
TESTNET_USDC_ASSET_ID=10458941

# --- Algorand / x402 — mainnet ------------------------------------------------
MAINNET_ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud
MAINNET_X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
MAINNET_PAY_TO_ADDRESS=REPLACE_WITH_MAINNET_ALGORAND_ADDRESS
MAINNET_USDC_ASSET_ID=31566704

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — shared `postgres` container on the `alpha` network.
# sitelenz_db / sitelenz_user already exist on the server per infra setup.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://sitelenz_user:REPLACE_WITH_PASSWORD@postgres:5432/sitelenz_db

# -----------------------------------------------------------------------------
# Redis (BullMQ) — shared `redis` container on the `alpha` network.
# REDIS_KEY_PREFIX namespaces every key this app writes so it can't collide
# with other apps on the same shared Redis instance. Bare word, no trailing
# colon — BullMQ joins "<prefix>:<queue>:..." itself.
# -----------------------------------------------------------------------------
REDIS_URL=redis://:REPLACE_WITH_PASSWORD@redis:6379
REDIS_KEY_PREFIX=sitelenz

# -----------------------------------------------------------------------------
# Cloudinary (screenshot storage)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=REPLACE
CLOUDINARY_API_KEY=REPLACE
CLOUDINARY_API_SECRET=REPLACE

# -----------------------------------------------------------------------------
# Groq (AI provider)
# -----------------------------------------------------------------------------
GROQ_API_KEY=REPLACE
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# Webhook delivery signing secret
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Analysis behavior
# -----------------------------------------------------------------------------
ANALYSIS_CACHE_TTL_HOURS=48
MAX_CONCURRENT_ANALYSES=3
ANALYSIS_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# x402 payment amounts (USD)
# -----------------------------------------------------------------------------
X402_PRICE_STANDARD_USD=1
X402_PRICE_DEEP_USD=2
