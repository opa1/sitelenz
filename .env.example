# =============================================================================
# SiteLenz — environment variables
# Copy this file to .env and fill in real values. Nothing here should be read
# directly with process.env outside of src/config — always go through
# AppConfigService.
# =============================================================================

# Server port
PORT=3000

# -----------------------------------------------------------------------------
# NETWORK — selects which of the network-specific blocks below is active.
# One of: testnet | mainnet
# -----------------------------------------------------------------------------
NETWORK=testnet

# --- Algorand / x402 — testnet -----------------------------------------------
TESTNET_ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
# GoPlausible facilitator — same URL serves both testnet and mainnet; network is
# selected per-request via the CAIP-2 network id, not the URL.
TESTNET_X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
TESTNET_PAY_TO_ADDRESS=
TESTNET_USDC_ASSET_ID=10458941

# --- Algorand / x402 — mainnet ------------------------------------------------
MAINNET_ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud
MAINNET_X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
MAINNET_PAY_TO_ADDRESS=
MAINNET_USDC_ASSET_ID=31566704

# -----------------------------------------------------------------------------
# Database (PostgreSQL). Matches docker-compose.yml service `postgres`.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://sitelenz:sitelenz@localhost:5432/sitelenz?schema=public"

# -----------------------------------------------------------------------------
# Redis (BullMQ). Matches docker-compose.yml service `redis`.
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Cloudinary (screenshot storage)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Groq (AI provider)
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Webhook delivery signing secret
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Analysis behavior
# -----------------------------------------------------------------------------
# How long a completed analysis is cached before it expires (hours)
ANALYSIS_CACHE_TTL_HOURS=48
# Max number of analyses processed concurrently by the worker
MAX_CONCURRENT_ANALYSES=3
# Per-analysis timeout in milliseconds
ANALYSIS_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# x402 payment amounts (USD). Not network-specific. Subject to change, so they
# are read from env rather than hardcoded in the guard.
# -----------------------------------------------------------------------------
X402_PRICE_STANDARD_USD=1
X402_PRICE_DEEP_USD=2
