# =============================================================================
# SiteLenz - production deployment checklist
# One line per required env var, no placeholder values - fill each in with
# your own production secret/config before deploying. See .env.example for
# documented defaults/local-dev values instead.
# =============================================================================

# Port the HTTP server listens on. Deployment platforms (Railway/Render) set
# this automatically - only override if self-hosting.
PORT=

# Which network block below is active: testnet | mainnet. Only this network's
# ALGORAND_NODE_URL / PAY_TO_ADDRESS / USDC_ASSET_ID are required at boot.
NETWORK=

# --- Algorand / x402 - testnet (required only when NETWORK=testnet) --------
# Algorand node RPC endpoint used for testnet transactions.
TESTNET_ALGORAND_NODE_URL=
# x402 payment facilitator URL (GoPlausible) - same value for both networks.
TESTNET_X402_FACILITATOR_URL=
# Your Algorand testnet wallet address that receives analysis payments.
TESTNET_PAY_TO_ADDRESS=
# Testnet USDC Algorand Standard Asset (ASA) id.
TESTNET_USDC_ASSET_ID=

# --- Algorand / x402 - mainnet (required only when NETWORK=mainnet) --------
# Algorand node RPC endpoint used for mainnet transactions.
MAINNET_ALGORAND_NODE_URL=
# x402 payment facilitator URL (GoPlausible) - same value for both networks.
MAINNET_X402_FACILITATOR_URL=
# Your Algorand mainnet wallet address that receives analysis payments -
# real funds flow here, double-check this before going live.
MAINNET_PAY_TO_ADDRESS=
# Mainnet USDC Algorand Standard Asset (ASA) id - 31566704 is Algorand's
# official mainnet USDC and normally doesn't need to change.
MAINNET_USDC_ASSET_ID=

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string (with schema/sslmode as needed).
DATABASE_URL=

# --- Redis (BullMQ) ------------------------------------------------------------
# Redis connection string used for the analysis and webhook job queues.
REDIS_URL=

# --- Cloudinary (screenshot storage) -----------------------------------------
# Cloudinary account cloud name.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key.
CLOUDINARY_API_KEY=
# Cloudinary API secret.
CLOUDINARY_API_SECRET=

# --- Groq (AI report interpretation) -----------------------------------------
# Groq API key used for the AI interpretation layer.
GROQ_API_KEY=
# Groq chat model id to use - check Groq's current model catalog before
# deploying, as model availability changes over time.
GROQ_MODEL=

# --- Webhooks ------------------------------------------------------------------
# HMAC-SHA256 signing secret for outbound analysis-completion webhooks -
# generate a long random value, never reuse across environments.
WEBHOOK_SECRET=

# --- Analysis behavior -----------------------------------------------------
# Hours a completed analysis result is served from cache before re-running.
ANALYSIS_CACHE_TTL_HOURS=
# Max analyses allowed to be status=running at once before new requests 429.
MAX_CONCURRENT_ANALYSES=
# Per-analysis timeout in milliseconds before the job is aborted as failed.
ANALYSIS_TIMEOUT_MS=

# --- x402 payment amounts (USD) ----------------------------------------------
# Price charged for a standard analysis.
X402_PRICE_STANDARD_USD=
# Price charged for a deep analysis.
X402_PRICE_DEEP_USD=
