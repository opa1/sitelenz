// Prisma schema for SiteLenz
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum ScreenshotType {
  desktop
  mobile
}

enum CrawlType {
  lightweight
  full
}

enum AnalyzeJobStatus {
  queued
  running
  completed
  failed
}

model Screenshot {
  id                 String         @id @default(uuid())
  analyzeJobId       String?
  type               ScreenshotType
  cloudinaryUrl      String
  cloudinaryPublicId String
  createdAt          DateTime       @default(now())

  @@index([analyzeJobId])
  @@map("screenshots")
}

model CrawlObservation {
  id               String    @id
  url              String
  normalizedUrl    String
  rawObservations  Json
  crawlType        CrawlType
  createdAt        DateTime  @default(now())
  expiresAt        DateTime

  @@index([normalizedUrl, crawlType, createdAt])
  @@map("crawl_observations")
}

model AnalyzeJob {
  id                  String           @id
  endpoint            String
  url                 String
  normalizedUrl       String
  status              AnalyzeJobStatus @default(queued)
  progressStage       String           @default("queued")
  errorMessage        String?
  webhookUrl          String?
  result              Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  completedAt         DateTime?

  webhookDeliveries AnalyzeWebhookDelivery[]

  @@index([normalizedUrl, endpoint, status, createdAt])
  @@map("analyze_jobs")
}

model AnalyzeWebhookDelivery {
  id             String                @id @default(cuid())
  analyzeJobId   String
  analyzeJob     AnalyzeJob            @relation(fields: [analyzeJobId], references: [id], onDelete: Cascade)
  url            String
  event          String
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  responseStatus Int?
  createdAt      DateTime              @default(now())

  @@index([analyzeJobId])
  @@map("analyze_webhook_deliveries")
}
