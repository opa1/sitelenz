// Prisma schema for SiteLenz
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisType {
  standard
  deep
}

enum AnalysisStatus {
  queued
  running
  completed
  failed
  expired
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum ScreenshotType {
  desktop
  mobile
}

enum CrawlType {
  lightweight
  full
}

enum AnalyzeJobStatus {
  queued
  running
  completed
  failed
}

model Analysis {
  id             String         @id
  url            String
  analysisType   AnalysisType   @default(standard)
  status         AnalysisStatus @default(queued)
  progressStage  String         @default("pending")
  errorMessage   String?
  webhookUrl     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  completedAt    DateTime?

  report            AnalysisReport?
  webhookDeliveries WebhookDelivery[]
  screenshots       Screenshot[]

  @@index([url, analysisType, status])
  @@map("analyses")
}

model AnalysisReport {
  id         String   @id @default(uuid())
  analysisId String   @unique
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  report     Json
  createdAt  DateTime @default(now())

  @@map("analysis_reports")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  analysisId     String
  analysis       Analysis              @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  url            String
  event          String
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  responseStatus Int?
  createdAt      DateTime              @default(now())

  @@index([analysisId])
  @@map("webhook_deliveries")
}

model Screenshot {
  id                 String         @id @default(uuid())
  analysisId         String?
  analysis           Analysis?      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analyzeJobId       String?
  type               ScreenshotType
  cloudinaryUrl      String
  cloudinaryPublicId String
  createdAt          DateTime       @default(now())

  @@index([analysisId])
  @@index([analyzeJobId])
  @@map("screenshots")
}

model CrawlObservation {
  id               String    @id
  url              String
  normalizedUrl    String
  rawObservations  Json
  crawlType        CrawlType
  createdAt        DateTime  @default(now())
  expiresAt        DateTime

  @@index([normalizedUrl, crawlType, createdAt])
  @@map("crawl_observations")
}

model AnalyzeJob {
  id                  String           @id
  endpoint            String
  url                 String
  normalizedUrl       String
  status              AnalyzeJobStatus @default(queued)
  progressStage       String           @default("queued")
  errorMessage        String?
  webhookUrl          String?
  crawlObservationId  String?
  findings            Json?
  result              Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  completedAt         DateTime?

  webhookDeliveries AnalyzeWebhookDelivery[]

  @@index([normalizedUrl, endpoint, status, createdAt])
  @@map("analyze_jobs")
}

model AnalyzeWebhookDelivery {
  id             String                @id @default(cuid())
  analyzeJobId   String
  analyzeJob     AnalyzeJob            @relation(fields: [analyzeJobId], references: [id], onDelete: Cascade)
  url            String
  event          String
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  responseStatus Int?
  createdAt      DateTime              @default(now())

  @@index([analyzeJobId])
  @@map("analyze_webhook_deliveries")
}
